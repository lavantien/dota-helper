, 'when': [{ 'kind': 'enemyVisibleAny', 'heroes': ['sniper', 'drow-ranger', 'shadow-fiend', 'crystal-maiden'] }], 'action': 'bonus', 'note': 'the walk flank reaches every immobile back', 'origin': 'authored' }, { 'id': 'leshrac-dive-veto', 'target': 'leshrac', 'roles': ['2'], 'when': [{ 'kind': 'enemyVisibleAny', 'heroes': ['spirit-breaker', 'storm-spirit', 'slark', 'riki'] }], 'action': 'hard_gate', 'note': 'the gap close lands before pulse nova pays', 'origin': 'authored' }, { 'id': 'lich-melee-flood-boost', 'target': 'lich', 'roles': ['5'], 'when': [{ 'kind': 'enemyVisibleAnyCountMin', 'heroes': ['phantom-lancer', 'lifestealer', 'terrorblade', 'troll-warlord', 'sven', 'faceless-void', 'ursa', 'tiny', 'legion-commander', 'bristleback', 'axe', 'spirit-breaker'], 'count': 3 }], 'action': 'bonus', 'note': 'frost shield and chain frost tax every melee body that commits', 'origin': 'authored' }, { 'id': 'enigma-silence-penalty', 'target': 'enigma', 'roles': ['3'], 'when': [{ 'kind': 'enemyVisibleAny', 'heroes': ['silencer', 'drow-ranger', 'disruptor', 'treant', 'rubick', 'beastmaster'] }], 'action': 'penalty', 'note': 'every silence cancels the hole channel, count them before the commit', 'origin': 'authored' }, { 'id': 'nyx-caster-boost', 'target': 'nyx-assassin', 'roles': ['4'], 'when': [{ 'kind': 'enemyVisibleAny', 'heroes': ['skywrath-mage', 'shadow-fiend', 'crystal-maiden', 'jakiro', 'lich', 'witch-doctor'] }], 'action': 'bonus', 'note': 'carapace turns their spell trades into self stuns', 'origin': 'authored' }, { 'id': 'brewmaster-summon-flood-boost', 'target': 'brewmaster', 'roles': ['3'], 'when': [{ 'kind': 'enemyVisibleAny', 'heroes': ['phantom-lancer', 'naga-siren', 'terrorblade', 'broodmother', 'natures-prophet', 'enigma'] }], 'action': 'bonus', 'note': 'storm dispel magic wipes every illusion and summon body the flood brings', 'origin': 'authored' }],
