    perHeroSource: { 'alchemist': 'opendota_explorer', 'anti-mage': 'stratz', 'bane': 'stratz', 'bounty-hunter': 'stratz', 'brewmaster': 'stratz', 'centaur': 'stratz', 'clinkz': 'stratz', 'dawnbreaker': 'stratz', 'doom': 'stratz', 'dragon-knight': 'stratz', 'enigma': 'stratz', 'juggernaut': 'stratz', 'leshrac': 'stratz', 'lich': 'stratz', 'lifestealer': 'stratz', 'lone-druid': 'stratz', 'luna': 'stratz', 'lycan': 'stratz', 'marci': 'stratz', 'mirana': 'stratz', 'monkey-king': 'stratz', 'natures-prophet': 'stratz', 'necrophos': 'stratz', 'nyx-assassin': 'stratz', 'pangolier': 'stratz', 'phantom-lancer': 'stratz', 'rattletrap': 'stratz', 'rubick': 'stratz', 'shadow-shaman': 'stratz', 'slardar': 'stratz', 'slark': 'stratz', 'spectre': 'stratz', 'storm-spirit': 'stratz', 'sven': 'stratz', 'terrorblade': 'stratz', 'timbersaw': 'stratz', 'tiny': 'stratz', 'viper': 'stratz', 'windranger': 'stratz', 'winter-wyvern': 'stratz', 'witch-doctor': 'stratz' }
  },
  gates: {
    roleNotes: { '1': 'pangolier flexing onto the carry seat for the roll flips and the swashbuckle poke, phantom lancer and sven into the squishy clumped lines, juggernaut for the spin immunity and the ward sieges, clinkz for the skeleton walk tempo and the archer sieges, lifestealer into tanks, spectre for the global haunt cleanup, lone druid for the relentless bear sieges, nature\'s prophet for the global farm and the split pressure, tiny for the toss catches and the tower pressure, alchemist for the greed farm and the early stun follow ups, monkey king for the jingu trade loops and the soldier ring sieges, terrorblade for the metamorph sieges and the sunder saves, luna for the glaive wave clear and the eclipse clump kills, windranger for the shackle picks and the focus fire deletes, anti mage for the counter spell and the split push tempo', '2': 'dedicated marci for the rebound pair setups and the unleash brawls, dragon knight into the magic mids, storm spirit for the zip tempo and the overload picks, leshrac for the pulse nova teamfights and the edict sieges, slark for the pickoffs and the late snowball, pangolier flexing in for the roll flips off either core seat', '3': 'dedicated enigma for the black hole teamfights and the eidolon pushes, timbersaw for the chain brawls and the reactive armor front, dawnbreaker for the global ult presence and the tanky front, brewmaster for the primal split teamfights and the earth brewling sieges, lycan for the wolf sieges and the unslowable shapeshift runs, necrophos as the sustain offlane that outlasts burst and deletes the tanky cores, doom for the ult that shuts any hero off and the devour lane lead, centaur for the stomp engages and the tanky front with the stampede saves, slardar for the corrosive haze strips and the amplified pick damage, viper for the poison kite lanes and the strike break picks', '4': 'dedicated rubick for the spell steals and the fade bolt trades, bounty hunter for the track economy, nyx assassin into the caster lines, mirana for the arrow picks and the moonlight engages, shadow shaman for the chain lockdown and the ward sieges from the roam', '5': 'dedicated winter wyvern for the curse turns and the cold embraces, bane for the nightmare setups and the fiend grip deletes, lich for the frost shield sieges and the chain frost teamfights, clockwerk for the cogs isolations and the flare globals, witch doctor for the maledict bites and the death ward bounces' },
    fallbackOrder: { '1': ['pangolier', 'phantom-lancer', 'clinkz', 'juggernaut', 'spectre', 'lifestealer', 'sven', 'anti-mage', 'windranger', 'luna', 'terrorblade', 'lone-druid', 'alchemist', 'monkey-king', 'tiny', 'natures-prophet'], '2': ['marci', 'dragon-knight', 'slark', 'leshrac', 'storm-spirit', 'pangolier'], '3': ['enigma', 'timbersaw', 'brewmaster', 'lycan', 'dawnbreaker', 'centaur', 'necrophos', 'slardar', 'doom', 'viper'], '4': ['bounty-hunter', 'nyx-assassin', 'shadow-shaman', 'mirana', 'rubick'], '5': ['lich', 'winter-wyvern', 'bane', 'witch-doctor', 'rattletrap'] },
    rules: [{ 'id': 'spectre-tank-veto', 'target': 'spectre', 'roles': ['1'], 'when': [{ 'kind': 'enemyVisibleAny', 'heroes': ['undying', 'necrophos', 'invoker', 'chen', 'io', 'meepo'] }], 'action': 'hard_gate', 'note': 'the tank plan dies before it exists, undying alone is brutal', 'origin': 'authored' }, { 'id': 'spectre-ranged-boost', 'target': 'spectre', 'roles': ['1'], 'when': [{ 'kind': 'enemyVisibleAny', 'heroes': ['sniper', 'drow-ranger'] }], 'action': 'bonus', 'note': 'haunt deletes the squishy backline', 'origin': 'authored' }, { 'id': 'dk-healcut-veto', 'target': 'dragon-knight', 'roles': ['2'], 'when': [{ 'kind': 'enemyVisibleAnyCountMin', 'heroes': ['viper', 'huskar', 'necrophos', 'spectre', 'timbersaw'], 'count': 2 }], 'action': 'hard_gate', 'note': 'heal cut and break turn dragon blood off', 'origin': 'authored' }, { 'id': 'dk-magic-mid-boost', 'target': 'dragon-knight', 'roles': ['2'], 'when': [{ 'kind': 'enemyVisibleAny', 'heroes': ['templar-assassin', 'puck'] }], 'action': 'bonus', 'note': 'puck and TA are free lanes', 'origin': 'authored' }, { 'id': 'ls-kite-veto', 'target': 'lifestealer', 'roles': ['1'], 'when': [{ 'kind': 'enemyVisibleAny', 'heroes': ['enigma', 'visage', 'leshrac', 'riki'] }], 'action': 'hard_gate', 'note': 'the flood and the invis kite blank the feast plan', 'origin': 'authored' }, { 'id': 'ls-tank-boost', 'target': 'lifestealer', 'roles': ['1'], 'when': [{ 'kind': 'enemyVisibleAny', 'heroes': ['shadow-fiend', 'gyrocopter', 'underlord'] }], 'action': 'bonus', 'note': 'rage blanks the disables and feast eats the tank', 'origin': 'authored' }, { 'id': 'clinkz-aoe-veto', 'target': 'clinkz', 'roles': ['1'], 'when': [{ 'kind': 'enemyVisibleAnyCountMin', 'heroes': ['axe', 'earthshaker', 'sand-king', 'dark-seer', 'magnataur', 'kunkka'], 'count': 2 }], 'action': 'hard_gate', 'note': 'the blink lockdown crew deletes the skeleton before strafe pays', 'origin': 'authored' }, { 'id': 'clinkz-paper-boost', 'target': 'clinkz', 'roles': ['1']