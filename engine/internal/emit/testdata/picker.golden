  gates: {
    roleNotes: { '1': 'lone druid for the relentless bear sieges, alchemist for the greed farm and the early stun follow ups, monkey king for the jingu trade loops and the soldier ring sieges, tiny for the toss catches and the tower pressure, sven for the cleave through the clumped lines, terrorblade for the metamorph sieges and the sunder saves, luna for the glaive wave clear and the eclipse clump kills, windranger for the shackle picks and the focus fire deletes, phantom lancer into the squishy clumped lines, clinkz for the skeleton walk tempo and the archer sieges, nature\'s prophet for the global farm and the split pressure, lifestealer into tanks, juggernaut for the spin immunity and the ward sieges, spectre for the global haunt cleanup, anti mage for the counter spell and the split push tempo, ursa for the swipes grind and the pit windows, phantom assassin for the blink strike crit deletes and the blur front, templar assassin for the refraction lanes and the meld picks with the trap vision watching the map', '2': 'dedicated pangolier for the roll flips through the fight and the swashbuckle poke, marci for the rebound pair setups and the unleash brawls, storm spirit for the zip tempo and the overload picks, slark for the pickoffs and the late snowball, dragon knight into the magic mids, leshrac for the pulse nova teamfights and the edict sieges, outworld destroyer for the astral picks and the eclipse mana drops', '3': 'doom for the ult that shuts any hero off and the devour lane lead, centaur for the stomp engages and the tanky front with the stampede saves, enigma for the black hole teamfights and the eidolon pushes, timbersaw for the chain brawls and the reactive armor front, slardar for the corrosive haze strips and the amplified pick damage, brewmaster for the primal split teamfights and the earth brewling sieges, lycan for the wolf sieges and the unslowable shapeshift runs, dawnbreaker for the global ult presence and the tanky front, necrophos as the sustain offlane that outlasts burst and deletes the tanky cores, viper for the poison kite lanes and the strike break picks, death prophet for the exorcism sieges and the silence tempo, dark seer for the vacuum clump setups and the replica walls that cash the enemy cores, largo for the rhapsody fight swings and the lick dispels that flip the spell trades', '4': 'dedicated rubick for the spell steals and the fade bolt trades, bounty hunter for the track economy, nyx assassin into the caster lines, tusk for the snowball commits and the walrus punch deletes, hoodwink for the bushwhack stuns and the sharpshooter snipes, mirana for the arrow picks and the moonlight engages, shadow shaman for the chain lockdown and the ward sieges from the roam, earthshaker for the fissure cuts and the echo slams that cash the clump', '5': 'dedicated winter wyvern for the curse turns and the cold embraces, bane for the nightmare setups and the fiend grip deletes, clockwerk for the cogs isolations and the flare globals, enchantress for the converted neutral sieges and the impetus gap taxes, lich for the frost shield sieges and the chain frost teamfights, witch doctor for the maledict bites and the death ward bounces, ancient apparition for the ice blast shatters and the heal cut that starves the sustain drafts, techies for the mine carpets that tax every rotation and the blast off trades, venomancer for the gale chases and the plague ward carpets that zone every objective' },
    fallbackOrder: { '1': ['phantom-lancer', 'clinkz', 'juggernaut', 'spectre', 'lifestealer', 'sven', 'anti-mage', 'windranger', 'phantom-assassin', 'ursa', 'luna', 'terrorblade', 'lone-druid', 'templar-assassin', 'alchemist', 'tiny', 'natures-prophet', 'monkey-king'], '2': ['marci', 'dragon-knight', 'outworld-destroyer', 'slark', 'leshrac', 'pangolier', 'storm-spirit'], '3': ['enigma', 'brewmaster', 'dawnbreaker', 'lycan', 'dark-seer', 'viper', 'centaur', 'necrophos', 'death-prophet', 'slardar', 'doom', 'largo', 'timbersaw'], '4': ['rubick', 'bounty-hunter', 'nyx-assassin', 'tusk', 'hoodwink', 'mirana', 'shadow-shaman', 'earthshaker'], '5': ['winter-wyvern', 'bane', 'rattletrap', 'venomancer', 'enchantress', 'techies', 'lich', 'witch-doctor', 'ancient-apparition'] },
    rules: [{ 'id': 'spectre-tank-veto', 'target': 'spectre', 'roles': ['1'], 'when': [{ 'kind': 'enemyVisibleAny', 'heroes': ['undying', 'necrophos', 'invoker', 'chen', 'io', 'meepo'] }], 'action': 'hard_gate', 'note': 'the tank plan dies before it exists, undying alone is brutal', 'origin': 'authored' }, { 'id': 'spectre-ranged-boost', 'target': 'spectre', 'roles': ['1'], 'when': [{ 'kind': 'enemyVisibleAny', 'heroes': ['sniper', 'drow-ranger'] }], 'action': 'bonus', 'note': 'haunt deletes the squishy backline', 'origin': 'authored' }, { 'id': 'dk-healcut-veto', 'target': 'dragon-knight', 'roles': ['2'], 'when': [{ 'kind': 'enemyVisibleAnyCountMin', 'heroes': ['viper', 'huskar', 'necrophos', 'spectre', 'timbersaw'], 'count': 2 }], 'action': 'hard_gate', 'note': 'heal cut and break turn dragon blood off', 'origin': 'authored' }, { 'id': 'dk-magic-mid-boost', 'target': 'dragon-knight', 'roles': ['2'], 'when': [{ 'kind': 'enemyVisibleAny', 'heroes': ['templar-assassin', 'puck'] }], 'action': 'bonus', 'note': 'puck and TA are free lanes', 'origin': 'authored' }, { 'id': 'ls-kite-veto', 'target': 'lifestealer', 'roles': ['1'], 'when': [{ 'kind': 'enemyVisibleAny', 'heroes': ['enigma', 'visage', 'leshrac', 'riki'] }], 'action': 'hard_gate', 'note': 'the flood and the invis kite blank the feast plan', 'origin': 'authored' }, { 'id': 'ls-tank-boost', 'target': 'lifestealer', 'roles': ['1'], 'when': [{ 'kind': 'enemyVisibleAny', 'heroes': ['shadow-fiend', 'gyrocopter', 'underlord'] }], 'action': 'bonus', 'note': 'rage blanks the disables and feast eats the tank', 'origin': 'authored' }, { 'id': 'clinkz-aoe-veto', 'target': 'clinkz', 'roles': ['1'], 'when': [{ 'kind': 'enemyVisibleAnyCountMin', 'heroes': ['axe', 'earthshaker', 'sand-king', 'dark-seer', 'magnataur', 'kunkka'], 'count': 2 }], 'action': 'hard_gate', 'note': 'the blink lockdown crew deletes the skeleton before strafe pays', 'origin': 'authored' }, { 'id': 'clinkz-paper-boost', 'target': 'clinkz', 'roles': ['1']